  "payload_cases": [
    {
      "name": "v1 payment link payload",
      "payload": {
        "id": "pl_01JABCDEF123",
        "status": "ACTIVE",
        "maxAmount": "10.50",
        "token": "0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913",
        "networkId": 8453,
        "preApprovalExpiry": "1893456000",
        "maxUsage": 1,
        "usageCount": 0,
        "contractAddress": "0xAbCdEf0123456789aBcDeF0123456789ABCDEF01",
        "nonce": "0xABABABABABABABABABABABABABABABAB0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f",
        "merchant": {
          "name": "OpenRouter"
        },
        "fiat": {
          "amount": "10.50",
          "currency": "USD"
        }
      },
      "expected_fingerprint": "d8fafacabbcd1ee5e65391046a24168decd965eae2f9035d2ba54ac02e875d9a"
    },
    {
      "name": "v1 merchant display name never enters the hash",
      "payload": {
        "id": "pl_01JABCDEF123",
        "status": "ACTIVE",
        "maxAmount": "10.50",
        "token": "0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913",
        "networkId": 8453,
        "preApprovalExpiry": "1893456000",
        "maxUsage": 1,
        "usageCount": 0,
        "contractAddress": "0xAbCdEf0123456789aBcDeF0123456789ABCDEF01",
        "nonce": "0xABABABABABABABABABABABABABABABAB0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f",
        "merchant": {
          "name": "Totally Different Name"
        },
        "fiat": {
          "amount": "10.50",
          "currency": "USD"
        }
      },
      "expected_fingerprint": "d8fafacabbcd1ee5e65391046a24168decd965eae2f9035d2ba54ac02e875d9a"
    },
    {
